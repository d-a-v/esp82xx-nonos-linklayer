+/*
+   --------------------------------------------------
+   ----------------- TIME-WAIT tweak ----------------
+   --------------------------------------------------
+   port @me-no-dev time-wait tweak
+   https://github.com/esp8266/Arduino/commit/07f4d4c241df2c552899857f39a4295164f686f2#diff-f8258e71e25fb9985ca3799e3d8b88ecR399
+
+   port @scardus patch to limit already waiting pcbs
+   https://github.com/d-a-v/esp82xx-nonos-linklayer/commit/42d4cc2e2d83f10d8a34502ae1303b3bb45eb030
+*/
+
+/* tcp.c internal non-static func not exported by tcp_priv.h */
+void tcp_kill_timewait (void);
+
+static inline void
+tcp_kill_timewait_limit(u32_t limit)
+{
+  if (!tcp_tw_pcbs)
+    return;
+
+  u32_t count = 0;
+  for (struct tcp_pcb* tmp = tcp_tw_pcbs; tmp != NULL; tmp = tmp->next)
+    ++count;
+
+  /* lt vs. le, always process the most recent one */
+  if (count < limit)
+    return;
+
+  /* kills the oldest pcb in TW state, one at a time */
+  count -= limit;
+  for (u32_t n = 0; n < count; ++n)
+    tcp_kill_timewait();
+}
+
 /** Initial CWND calculation as defined RFC 2581 */
 #define LWIP_TCP_CALC_INITIAL_CWND(mss) ((tcpwnd_size_t)LWIP_MIN((4U * (mss)), LWIP_MAX((2U * (mss)), 4380U)))
 
