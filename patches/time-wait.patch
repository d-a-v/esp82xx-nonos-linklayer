Author: Maxim Prokhorov <prokhorov.max@outlook.com>
Date: 2026-11-21 08:06:02 +0300
Subject: remove oldest pcbs in time-wait state when max number of them is reached

port of time-wait patch from esp8266 Core by Me No Dev <me-no-dev@users.noreply.github.com>
https://github.com/esp8266/Arduino/commit/07f4d4c241df2c552899857f39a4295164f686f2#diff-f8258e71e25fb9985ca3799e3d8b88ecR399

Initial patch d-a-v/esp82xx-nonos-linklayer#17 by david gauchard <gauchard@laas.fr>
Fixed tcp_abort() d-a-v/esp82xx-nonos-linklayer#69 by Sean Cardus <sean@cardus.com>

Signed-off-by: Maxim Prokhorov <prokhorov.max@outlook.com>

---
 src/core/tcp.c    |    2 +-
 src/core/tcp_in.c |    6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/core/tcp.c b/src/core/tcp.c
index 8c252189..7241130d 100644
--- a/src/core/tcp.c
+++ b/src/core/tcp.c
@@ -1784,7 +1784,7 @@ tcp_kill_state(enum tcp_state state)
  * Kills the oldest connection that is in TIME_WAIT state.
  * Called from tcp_alloc() if no more connections are available.
  */
-static void
+void
 tcp_kill_timewait(void)
 {
   struct tcp_pcb *pcb, *inactive;
diff --git a/src/core/tcp_in.c b/src/core/tcp_in.c
index 2202e381..bb021c86 100644
--- a/src/core/tcp_in.c
+++ b/src/core/tcp_in.c
@@ -997,6 +997,8 @@ tcp_process(struct tcp_pcb *pcb)
           tcp_pcb_purge(pcb);
           TCP_RMV_ACTIVE(pcb);
           pcb->state = TIME_WAIT;
+          /* limit before TCP_REG, so tcp_kill_timewait() cannot pick this pcb */
+          TCP_TW_LIMIT(MEMP_NUM_TCP_PCB_TIME_WAIT - 1);
           TCP_REG(&tcp_tw_pcbs, pcb);
         } else {
           tcp_ack_now(pcb);
@@ -1015,6 +1017,8 @@ tcp_process(struct tcp_pcb *pcb)
         tcp_pcb_purge(pcb);
         TCP_RMV_ACTIVE(pcb);
         pcb->state = TIME_WAIT;
+        /* limit before TCP_REG, so tcp_kill_timewait() cannot pick this pcb */
+        TCP_TW_LIMIT(MEMP_NUM_TCP_PCB_TIME_WAIT - 1);
         TCP_REG(&tcp_tw_pcbs, pcb);
       }
       break;
@@ -1025,6 +1029,8 @@ tcp_process(struct tcp_pcb *pcb)
         tcp_pcb_purge(pcb);
         TCP_RMV_ACTIVE(pcb);
         pcb->state = TIME_WAIT;
+        /* limit before TCP_REG, so tcp_kill_timewait() cannot pick this pcb */
+        TCP_TW_LIMIT(MEMP_NUM_TCP_PCB_TIME_WAIT - 1);
         TCP_REG(&tcp_tw_pcbs, pcb);
       }
       break;
