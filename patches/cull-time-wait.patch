Subject: remove oldest pcbs in time-wait state when max number of them is reached

port of time-wait patch from esp8266 Core by Me No Dev <me-no-dev@users.noreply.github.com>
https://github.com/esp8266/Arduino/commit/07f4d4c241df2c552899857f39a4295164f686f2#diff-f8258e71e25fb9985ca3799e3d8b88ecR399

Initial patch d-a-v/esp82xx-nonos-linklayer#17 by david gauchard <gauchard@laas.fr>
Fixed tcp_abort() d-a-v/esp82xx-nonos-linklayer#69 by Sean Cardus <sean@cardus.com>

use a local func instead of lwipopts.h macro. reuse tcp_kill_timewait logic, dont assume export
nb. flag named MEMP, while technically does not apply to a separate memory pool for tw pcbs

Signed-off-by: Maxim Prokhorov <prokhorov.max@outlook.com>
diff --git a/src/core/tcp_in.c b/src/core/tcp_in.c
index 1b17e40f..299fb243 100644
--- a/src/core/tcp_in.c
+++ b/src/core/tcp_in.c
@@ -65,6 +65,45 @@
 #include LWIP_HOOK_FILENAME
 #endif
 
+/* see tcp.c tcp_kill_timewait (void), c/p to avoid confusing linkage
+ * limit the total number of pcbs in time wait state by killing the oldest ones */
+static void
+tcp_limit_timewait(struct tcp_pcb **pcbs, u32_t limit) {
+  struct tcp_pcb *pcb, *inactive;
+  u32_t inactivity, plus_one_cnt;
+
+  inactivity = 0;
+  inactive = NULL;
+
+  plus_one_cnt = 1;
+  for (pcb = *pcbs; pcb != NULL; pcb = pcb->next)
+    ++plus_one_cnt;
+
+  /* Go through the list of TIME_WAIT pcbs and get the oldest pcb. */
+  while (--plus_one_cnt > limit) {
+    for (pcb = *pcbs; pcb != NULL; pcb = pcb->next) {
+      if ((u32_t)(tcp_ticks - pcb->tmr) >= inactivity) {
+        inactivity = tcp_ticks - pcb->tmr;
+        inactive = pcb;
+      }
+    }
+
+    if ((*pcbs == NULL) || (inactive == NULL)) {
+      break;
+    }
+
+    tcp_abort(inactive);
+    inactive = NULL;
+  }
+}
+
+/* WARNING! apply limit BEFORE calling TCP_REG so the current pcb would not be tcp_abort()'ed */
+#if defined MEMP_NUM_TCP_PCB_TIME_WAIT
+#define TCP_TW_LIMIT(pcbs) tcp_limit_timewait(pcbs, MEMP_NUM_TCP_PCB_TIME_WAIT - 1)
+#else
+#define TCP_TW_LIMIT(pcbs) LWIP_UNUSED_ARG(pcbs);
+#endif
+
 /** Initial CWND calculation as defined RFC 2581 */
 #define LWIP_TCP_CALC_INITIAL_CWND(mss) ((tcpwnd_size_t)LWIP_MIN((4U * (mss)), LWIP_MAX((2U * (mss)), 4380U)))
 
@@ -1009,6 +1048,7 @@ tcp_process(struct tcp_pcb *pcb)
           tcp_pcb_purge(pcb);
           TCP_RMV_ACTIVE(pcb);
           pcb->state = TIME_WAIT;
+          TCP_TW_LIMIT(&tcp_tw_pcbs);
           TCP_REG(&tcp_tw_pcbs, pcb);
         } else {
           tcp_ack_now(pcb);
@@ -1027,6 +1067,7 @@ tcp_process(struct tcp_pcb *pcb)
         tcp_pcb_purge(pcb);
         TCP_RMV_ACTIVE(pcb);
         pcb->state = TIME_WAIT;
+        TCP_TW_LIMIT(&tcp_tw_pcbs);
         TCP_REG(&tcp_tw_pcbs, pcb);
       }
       break;
@@ -1037,6 +1078,7 @@ tcp_process(struct tcp_pcb *pcb)
         tcp_pcb_purge(pcb);
         TCP_RMV_ACTIVE(pcb);
         pcb->state = TIME_WAIT;
+        TCP_TW_LIMIT(&tcp_tw_pcbs);
         TCP_REG(&tcp_tw_pcbs, pcb);
       }
       break;
