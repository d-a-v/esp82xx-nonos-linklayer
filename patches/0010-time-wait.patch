From 8f41f08ad10476ae23922499f776c9abb248168e Mon Sep 17 00:00:00 2001
From: esp82xx-nonos-linklayer <>
Date: Thu, 19 Nov 2026 01:29:21 +0300
Subject: [PATCH 10/10]

---
 src/core/tcp.c    | 2 +-
 src/core/tcp_in.c | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/core/tcp.c b/src/core/tcp.c
index 7233fe13..a28db0ef 100644
--- a/src/core/tcp.c
+++ b/src/core/tcp.c
@@ -1789,7 +1789,7 @@ tcp_kill_state(enum tcp_state state)
  * Kills the oldest connection that is in TIME_WAIT state.
  * Called from tcp_alloc() if no more connections are available.
  */
-static void
+void
 tcp_kill_timewait(void)
 {
   struct tcp_pcb *pcb, *inactive;
diff --git a/src/core/tcp_in.c b/src/core/tcp_in.c
index 1b17e40f..970c0cbe 100644
--- a/src/core/tcp_in.c
+++ b/src/core/tcp_in.c
@@ -1009,6 +1009,8 @@ tcp_process(struct tcp_pcb *pcb)
           tcp_pcb_purge(pcb);
           TCP_RMV_ACTIVE(pcb);
           pcb->state = TIME_WAIT;
+          /* limit before TCP_REG, so tcp_kill_timewait() cannot pick this pcb */
+          TCP_TW_LIMIT(MEMP_NUM_TCP_PCB_TIME_WAIT - 1);
           TCP_REG(&tcp_tw_pcbs, pcb);
         } else {
           tcp_ack_now(pcb);
@@ -1027,6 +1029,8 @@ tcp_process(struct tcp_pcb *pcb)
         tcp_pcb_purge(pcb);
         TCP_RMV_ACTIVE(pcb);
         pcb->state = TIME_WAIT;
+        /* limit before TCP_REG, so tcp_kill_timewait() cannot pick this pcb */
+        TCP_TW_LIMIT(MEMP_NUM_TCP_PCB_TIME_WAIT - 1);
         TCP_REG(&tcp_tw_pcbs, pcb);
       }
       break;
@@ -1037,6 +1041,8 @@ tcp_process(struct tcp_pcb *pcb)
         tcp_pcb_purge(pcb);
         TCP_RMV_ACTIVE(pcb);
         pcb->state = TIME_WAIT;
+        /* limit before TCP_REG, so tcp_kill_timewait() cannot pick this pcb */
+        TCP_TW_LIMIT(MEMP_NUM_TCP_PCB_TIME_WAIT - 1);
         TCP_REG(&tcp_tw_pcbs, pcb);
       }
       break;
-- 
