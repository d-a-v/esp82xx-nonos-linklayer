-include .config.mk
include makefiles/include/common.mk

maybe-prefix = $(if $(PREFIX),$(PREFIX)/$(1),$(error prefix must be set to esp8266 Core root directory))

export TOOLS ?= $(call maybe-prefix,tools/xtensa-lx106-elf/bin)
export SDK ?= $(call maybe-prefix,tools/sdk)
export LIBS ?= $(call maybe-prefix,tools/sdk/lib)
export INC ?= $(call maybe-prefix,tools/sdk/lwip2/include)

export LWIP14_INCLUDE_DIR ?= $(ROOT)/glue-esp/lwip-1.4-arduino/include

export PREFIX_TARGET := arduino
export CPPFLAGS += -DARDUINO=1

include makefiles/include/install.mk
