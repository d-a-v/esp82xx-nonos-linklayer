-include .config.mk
include makefiles/include/common.mk

export lwip14includedir ?= $(ROOT)/glue-esp/lwip-1.4-arduino/include

maybe-prefix = $(if $(PREFIX),$(PREFIX)/$(1),$(error prefix must be set to esp8266 Core root directory))

export includedir ?= $(call maybe-prefix,tools/sdk/lwip2/include)
export libdir ?= $(call maybe-prefix,tools/sdk/lib)
export sdkincludedir ?= $(call maybe-prefix,tools/sdk/include)

export CC ?= $(call maybe-prefix,tools/xtensa-lx106-elf/bin/xtensa-lx106-elf-gcc)
export AR ?= $(call maybe-prefix,tools/xtensa-lx106-elf/bin/xtensa-lx106-elf-ar)

export PREFIX_TARGET := arduino
export CPPFLAGS += -DARDUINO=1

include makefiles/include/install.mk
