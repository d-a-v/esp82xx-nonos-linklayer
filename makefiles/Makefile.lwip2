# this one is executed from directory lwip2-src/src/

LWIPDIR := .

include Filelists.mk

SRC := \
	$(LWIPNOAPPSFILES) \
	$(SNTPFILES)

CPPFLAGS += \
	-I$(BUILD_ROOT) \
	-I$(SDK)/include \
	-I$(ROOT)/glue \
	-I$(ROOT)/glue-lwip \
	-I$(ROOT)/glue-lwip/$(PREFIX_TARGET) \
	-I$(LWIP_ROOT)/src/include

BUILD_COMPONENT := lwip2

include $(ROOT)/makefiles/include/defs.mk
include $(ROOT)/makefiles/include/rules.mk

-include $(BUILD)/*/*.d
-include $(BUILD)/*/*/*.d
-include $(BUILD)/*/*/*/*.d
