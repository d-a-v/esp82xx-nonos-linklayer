# recipe is part of the build-lwip2

include $(ROOT)/makefiles/include/defs.mk

include $(BUILD)/glue.d
include $(BUILD)/glue-esp.d
include $(BUILD)/glue-lwip.d
include $(BUILD)/lwip2-src.d

.PHONY: all
all: $(LWIP_LIB)

# .a is a flat archive, make sure .o is unique
# .o paths expected to mirror source locations

ARCHIVE := $(BUILD_ROOT)/archive_$(notdir $(LWIP_LIB))

$(LWIP_LIB):
	mkdir -p $(ARCHIVE)
	(set -e; cd $(ARCHIVE); \
		for f in $^; do \
			cp -l $$f $$(realpath --relative-to="$(BUILD)" $$f | tr '/-' '_'); \
		done)
	$(AR) cDr $@ $(ARCHIVE)/*.o
	rm -rf $(ARCHIVE)
