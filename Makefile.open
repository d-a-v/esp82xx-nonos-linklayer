-include .config.mk
include makefiles/include/common.mk

maybe-prefix = $(if $(PREFIX),$(PREFIX)/$(1),$(error prefix must be set))
maybe-sdk = $(if $(SDK),$(SDK)/$(1),$(error sdk path must be set))

export SDK ?= $(call maybe-prefix,xtensa-lx106-elf/sysroot/usr)
export LIBS ?= $(call maybe-sdk,lib)
export INC ?= $(call maybe-sdk,include/lwip2)

export LWIP14_INCLUDE_DIR := $(call maybe-prefix,../sdk/third_party/include)

export PREFIX_TARGET := open
export CPPFLAGS += -DOPENSDK=1

$(shell scripts/patch-vendor-lwip14.sh \
	$(LWIP14_INCLUDE_DIR) \
)

$(shell scripts/patch-non-local-includes.sh \
	$(PREFIX)/xtensa-lx106-elf/sysroot/usr/include \
)

include makefiles/include/install.mk
