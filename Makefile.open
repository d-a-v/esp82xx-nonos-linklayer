-include .config.mk
include makefiles/include/common.mk

maybe-prefix = $(if $(PREFIX),$(PREFIX)/$(1),$(error prefix must be set))

export lwip14includedir := $(call maybe-prefix,../sdk/third_party/include)

SDK ?= $(call maybe-prefix,xtensa-lx106-elf/sysroot/usr)

maybe-sdk = $(if $(SDK),$(SDK)/$(1),$(error sdk path must be set))

export libdir ?= $(call maybe-sdk,lib)
export includedir ?= $(call maybe-sdk,include/lwip2/)

export lwipoptsincludedir = $(ROOT)/glue-lwip/open/

export GLUE_HEADERS += \
	$(ROOT)/glue-lwip/open/lwipopts.h

export GLUE_LWIP_SRC += \
	glue-lwip/esp-dhcpserver.c \
	glue-lwip/esp-time.c \
	glue-lwip/esp-millis.c

export GLUE_APP_HEADERS += \
	$(ROOT)/glue-lwip/lwip/apps-esp/dhcpserver.h \
	$(ROOT)/glue-lwip/lwip/apps-esp/espconn.h

export CC ?= $(call maybe-prefix,bin/xtensa-lx106-elf-gcc)
export AR ?= $(call maybe-prefix,bin/xtensa-lx106-elf-ar)

export CPPFLAGS += -DOPENSDK=1

$(shell scripts/patch-vendor-lwip14.sh \
	$(LWIP14_INCLUDE_DIR) \
)

$(shell scripts/patch-non-local-includes.sh \
	$(PREFIX)/xtensa-lx106-elf/sysroot/usr/include \
)

include makefiles/include/install.mk
